# pnpm + Expo/React Native: плоский node_modules обязателен,
# иначе Metro не резолвит модули (символические ссылки pnpm ломают бандлинг).
node-linker=hoisted
# react-dom (web-зависимость expo-router) тянет более новый react, чем
# зафиксированный expo — не падаем на peer-конфликте.
strict-peer-dependencies=false
