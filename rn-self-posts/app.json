{
  "expo": {
    "name": "Self Blog",
    "slug": "rn-self-posts",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rnselfposts",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexmaster.rnselfposts"
    },
    "android": {
      "package": "com.alexmaster.rnselfposts",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#303F9F"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#242832"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы прикреплять их к постам.",
          "cameraPermission": "Приложению нужен доступ к камере, чтобы делать фото для постов."
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
